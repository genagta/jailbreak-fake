<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>Dopamine</title>

  <!-- iOS PWA мета-теги -->
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Dopamine" />
  <meta name="theme-color" content="#061d12" id="meta-theme-color" />
  <link rel="apple-touch-icon" sizes="512x512" id="apple-touch-icon" href="" />
  <link rel="icon" type="image/png" id="favicon" href="" />

  <style>
    :root {
      --bg-top: #072b19;
      --bg-mid: #0b4a2b;
      --bg-bot: #04140c;
      --glow-1: rgba(34, 197, 94, 0.42);
      --glow-2: rgba(16, 185, 129, 0.22);
      --accent: #34d399;
      --card-bg: rgba(10, 18, 14, 0.56);
      --card-border: rgba(255, 255, 255, 0.11);
      --btn-bg: rgba(255, 255, 255, 0.13);
      --btn-bg-active: rgba(255, 255, 255, 0.22);
      --text-main: #ffffff;
      --text-dim: rgba(255, 255, 255, 0.65);
      --text-disabled: rgba(255, 255, 255, 0.3);
      --divider: rgba(255, 255, 255, 0.09);
    }

    body[data-theme="blue"] {
      --bg-top: #071b36;
      --bg-mid: #0c3973;
      --bg-bot: #040d1c;
      --glow-1: rgba(59, 130, 246, 0.45);
      --glow-2: rgba(14, 165, 233, 0.25);
      --accent: #60a5fa;
      --card-bg: rgba(10, 15, 26, 0.56);
    }

    body[data-theme="red"] {
      --bg-top: #380909;
      --bg-mid: #731313;
      --bg-bot: #1a0404;
      --glow-1: rgba(239, 68, 68, 0.44);
      --glow-2: rgba(185, 28, 28, 0.28);
      --accent: #f87171;
      --card-bg: rgba(24, 10, 10, 0.56);
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
      -webkit-user-select: none;
    }

    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100dvh;
      overflow: hidden;
      overscroll-behavior: none;
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Segoe UI", Roboto, sans-serif;
      color: var(--text-main);
      background: var(--bg-bot);
      touch-action: manipulation;
    }

    /* Фон с плавным переходом цветов */
    .bg-layer {
      position: fixed;
      inset: 0;
      z-index: 0;
      background:
        radial-gradient(circle at 20% 18%, var(--glow-1) 0%, transparent 55%),
        radial-gradient(circle at 85% 75%, var(--glow-2) 0%, transparent 58%),
        linear-gradient(165deg, var(--bg-top) 0%, var(--bg-mid) 48%, var(--bg-bot) 100%);
      transition: background 0.5s ease;
    }

    /* Главный контейнер */
    .app-shell {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 440px;
      height: 100dvh;
      margin: 0 auto;
      padding: calc(env(safe-area-inset-top, 20px) + 34px) 24px calc(env(safe-area-inset-bottom, 20px) + 28px);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    /* Шапка Dopamine */
    .header {
      padding-left: 4px;
      margin-bottom: 18px;
      transition: opacity 0.3s ease;
    }

    .title {
      font-size: 38px;
      font-weight: 700;
      letter-spacing: -0.025em;
      margin: 0;
      line-height: 1.1;
    }

    .subtitle {
      font-size: 15px;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.85);
      margin-top: 6px;
    }

    .sub-caption {
      font-size: 13px;
      color: var(--text-dim);
      margin-top: 3px;
    }

    /* Стеклянная карточка меню */
    .glass-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 22px;
      backdrop-filter: blur(26px);
      -webkit-backdrop-filter: blur(26px);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
      overflow: hidden;
      transition: all 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .menu-card {
      margin: auto 0;
      width: 100%;
    }

    .menu-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 20px;
      cursor: pointer;
      transition: background 0.2s ease, opacity 0.25s ease;
    }

    .menu-row:not(:last-child) {
      border-bottom: 1px solid var(--divider);
    }

    .menu-row:active:not(.disabled) {
      background: rgba(255, 255, 255, 0.08);
    }

    .menu-row.disabled {
      opacity: 0.35;
      pointer-events: none;
    }

    .menu-left {
      display: flex;
      align-items: center;
      gap: 14px;
      font-size: 16px;
      font-weight: 500;
    }

    .menu-icon {
      width: 22px;
      height: 22px;
      opacity: 0.9;
      flex-shrink: 0;
    }

    .chevron {
      width: 16px;
      height: 16px;
      opacity: 0.55;
    }

    /* Нижняя кнопка Jailbreak */
    .jb-btn {
      width: 100%;
      height: 58px;
      border: 1px solid var(--card-border);
      border-radius: 16px;
      background: var(--btn-bg);
      backdrop-filter: blur(22px);
      -webkit-backdrop-filter: blur(22px);
      color: #fff;
      font-size: 17px;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      cursor: pointer;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
      transition: transform 0.15s ease, background 0.2s ease, opacity 0.3s ease;
    }

    .jb-btn:active:not(:disabled) {
      transform: scale(0.98);
      background: var(--btn-bg-active);
    }

    .jb-btn:disabled {
      opacity: 0.5;
      cursor: default;
    }

    /* === ЭКРАН ПРОЦЕССА JAILBREAKING (как 00:04 - 00:11) === */
    .jb-panel {
      display: none;
      flex: 1;
      flex-direction: column;
      justify-content: space-between;
      padding: 20px;
      margin-top: 4px;
      position: relative;
      animation: panelIn 0.45s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .jb-panel.active {
      display: flex;
    }

    @keyframes panelIn {
      from { opacity: 0; transform: translateY(24px) scale(0.97); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .jb-panel-header {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      font-size: 16px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.9);
      padding-bottom: 14px;
      border-bottom: 1px solid var(--divider);
    }

    /* Выбор Package Manager */
    .pm-view {
      display: none;
      flex: 1;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 12px 4px;
      animation: fadeBlurIn 0.45s ease forwards;
    }

    .pm-view.active {
      display: flex;
    }

    @keyframes fadeBlurIn {
      from { opacity: 0; filter: blur(10px); transform: scale(0.96); }
      to { opacity: 1; filter: blur(0); transform: scale(1); }
    }

    .pm-title {
      font-size: 18px;
      font-weight: 600;
      margin-bottom: 26px;
    }

    .pm-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
      width: 100%;
      margin-bottom: 28px;
    }

    .pm-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      cursor: pointer;
    }

    .pm-icon-box {
      width: 72px;
      height: 72px;
      border-radius: 17px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
      border: 2px solid transparent;
      transition: transform 0.15s ease, border-color 0.2s ease;
      overflow: hidden;
    }

    .pm-item.selected .pm-icon-box {
      border-color: rgba(255, 255, 255, 0.85);
      transform: scale(1.04);
    }

    .pm-label-row {
      display: flex;
      align-items: center;
      gap: 5px;
      font-size: 13px;
      font-weight: 500;
    }

    .pm-check {
      width: 16px;
      height: 16px;
      border-radius: 50%;
      border: 1.5px solid rgba(255, 255, 255, 0.45);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 10px;
      transition: all 0.2s ease;
    }

    .pm-item.selected .pm-check {
      background: #fff;
      border-color: #fff;
      color: #000;
      font-weight: 800;
    }

    .pm-hint {
      font-size: 13px;
      color: var(--text-dim);
      max-width: 240px;
      line-height: 1.4;
      margin-bottom: 24px;
    }

    .continue-btn {
      width: 100%;
      max-width: 240px;
      height: 48px;
      border-radius: 13px;
      border: 1px solid rgba(255, 255, 255, 0.16);
      background: rgba(255, 255, 255, 0.16);
      color: #fff;
      font-size: 16px;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
      transition: opacity 0.2s ease, transform 0.15s ease;
    }

    .continue-btn:active:not(:disabled) {
      transform: scale(0.97);
    }

    .continue-btn:disabled {
      opacity: 0.35;
      pointer-events: none;
    }

    /* Логи процесса (00:09 - 00:11) */
    .log-feed {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      gap: 14px;
      padding: 16px 4px 8px;
      overflow: hidden;
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,0.45) 22%, #000 50%);
      mask-image: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,0.45) 22%, #000 50%);
    }

    .log-row {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 15px;
      color: rgba(255, 255, 255, 0.92);
      animation: rowSlide 0.35s ease forwards;
    }

    .log-row.sub {
      padding-left: 28px;
      font-size: 14px;
      color: rgba(255, 255, 255, 0.72);
    }

    .log-row.done {
      color: rgba(255, 255, 255, 0.72);
    }

    @keyframes rowSlide {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Спиннер в стиле iOS */
    .spinner {
      width: 16px;
      height: 16px;
      border: 2px solid rgba(255, 255, 255, 0.25);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.75s linear infinite;
      flex-shrink: 0;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* === МОДАЛЬНЫЕ ОКНА (Settings / Credits) === */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 20;
      background: rgba(0, 0, 0, 0.55);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 22px;
      animation: fadeIn 0.22s ease;
    }

    .modal-backdrop.open {
      display: flex;
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    .modal-sheet {
      width: 100%;
      max-width: 390px;
      max-height: 82dvh;
      overflow-y: auto;
      background: rgba(22, 24, 28, 0.88);
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 24px;
      padding: 20px;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6);
      animation: modalPop 0.28s cubic-bezier(0.22, 1, 0.36, 1);
    }

    @keyframes modalPop {
      from { opacity: 0; transform: scale(0.93) translateY(14px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }

    .modal-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 18px;
    }

    .modal-title {
      font-size: 18px;
      font-weight: 700;
    }

    .modal-close {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      border: none;
      background: rgba(255, 255, 255, 0.14);
      color: #fff;
      font-size: 16px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .section-label {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      color: rgba(255, 255, 255, 0.45);
      text-transform: uppercase;
      margin: 16px 0 10px 4px;
    }

    /* Переключатель тем */
    .theme-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }

    .theme-btn {
      border: 1.5px solid rgba(255, 255, 255, 0.12);
      background: rgba(255, 255, 255, 0.06);
      border-radius: 14px;
      padding: 12px 8px;
      color: #fff;
      font-size: 13px;
      font-weight: 600;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .theme-btn.active {
      border-color: #fff;
      background: rgba(255, 255, 255, 0.14);
    }

    .theme-dot {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      box-shadow: 0 0 14px currentColor;
    }

    .setting-toggle-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 13px 14px;
      background: rgba(255, 255, 255, 0.06);
      border-radius: 14px;
      margin-bottom: 10px;
      font-size: 14px;
    }

    .switch {
      position: relative;
      width: 44px;
      height: 26px;
      background: rgba(255, 255, 255, 0.2);
      border-radius: 20px;
      cursor: pointer;
      transition: background 0.25s ease;
    }

    .switch.on {
      background: #34c759;
    }

    .switch::after {
      content: "";
      position: absolute;
      top: 3px;
      left: 3px;
      width: 20px;
      height: 20px;
      background: #fff;
      border-radius: 50%;
      transition: transform 0.25s ease;
    }

    .switch.on::after {
      transform: translateX(18px);
    }

    .danger-btn {
      width: 100%;
      margin-top: 8px;
      padding: 13px;
      border-radius: 13px;
      border: 1px solid rgba(248, 113, 113, 0.35);
      background: rgba(239, 68, 68, 0.15);
      color: #fca5a5;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
    }

    /* Credits сетка (как на 00:02) */
    .credits-btn {
      width: 100%;
      padding: 13px;
      border-radius: 13px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.08);
      color: #fff;
      font-size: 15px;
      font-weight: 600;
      margin-bottom: 10px;
      text-align: center;
    }

    .credits-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      padding: 6px 4px;
      font-size: 14px;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.88);
    }

    /* === ЭКРАН VERBOSE BOOT / RESPRING (как 00:12 - 00:16) === */
    .verbose-screen {
      position: fixed;
      inset: 0;
      z-index: 50;
      background: #000;
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      padding: calc(env(safe-area-inset-top, 20px) + 70px) 18px calc(env(safe-area-inset-bottom, 20px) + 28px);
      opacity: 0;
      transition: opacity 0.45s ease;
    }

    .verbose-screen.visible {
      display: flex;
    }

    .verbose-screen.show {
      opacity: 1;
    }

    .boot-logo {
      width: 88px;
      height: 88px;
      margin-top: 40px;
      filter: drop-shadow(0 0 26px var(--glow-1));
      animation: logoPulse 2.2s ease-in-out infinite;
    }

    @keyframes logoPulse {
      0%, 100% { transform: scale(1); opacity: 0.92; }
      50% { transform: scale(1.05); opacity: 1; }
    }

    .verbose-terminal {
      width: 100%;
      max-width: 420px;
      height: 230px;
      overflow: hidden;
      font-family: "SF Mono", Menlo, Consolas, monospace;
      font-size: 12px;
      line-height: 1.55;
      color: #f3f4f6;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 32%);
      mask-image: linear-gradient(to bottom, transparent 0%, #000 32%);
    }

    .verbose-line {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Простой Respring-спиннер */
    .respring-screen {
      position: fixed;
      inset: 0;
      z-index: 55;
      background: #000;
      display: none;
      align-items: center;
      justify-content: center;
    }

    .respring-screen.active {
      display: flex;
    }

    .respring-spinner {
      width: 34px;
      height: 34px;
      border: 3px solid rgba(255, 255, 255, 0.2);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    /* === ЭКРАН БЛОКИРОВКИ В БРАУЗЕРЕ ("На экран Домой") === */
    .install-gate {
      position: fixed;
      inset: 0;
      z-index: 40;
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      padding: calc(env(safe-area-inset-top, 20px) + 40px) 24px calc(env(safe-area-inset-bottom, 20px) + 22px);
      background:
        radial-gradient(circle at 50% 15%, var(--glow-1) 0%, transparent 55%),
        linear-gradient(170deg, var(--bg-top) 0%, var(--bg-bot) 100%);
      text-align: center;
    }

    .install-gate.active {
      display: flex;
    }

    .gate-top {
      display: flex;
      flex-direction: column;
      align-items: center;
      max-width: 360px;
    }

    .gate-icon {
      width: 84px;
      height: 84px;
      border-radius: 20px;
      box-shadow: 0 14px 36px rgba(0, 0, 0, 0.5);
      margin-bottom: 18px;
      cursor: pointer;
    }

    .gate-badge {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent);
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.12);
      padding: 5px 12px;
      border-radius: 20px;
      margin-bottom: 12px;
    }

    .gate-title {
      font-size: 26px;
      font-weight: 700;
      margin: 0 0 8px;
    }

    .gate-desc {
      font-size: 14px;
      color: var(--text-dim);
      line-height: 1.45;
      margin: 0;
    }

    .gate-steps {
      width: 100%;
      max-width: 380px;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 22px;
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      padding: 18px 20px;
      text-align: left;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .step-item {
      display: flex;
      align-items: center;
      gap: 14px;
      font-size: 14px;
      line-height: 1.4;
    }

    .step-num {
      width: 30px;
      height: 30px;
      border-radius: 10px;
      background: rgba(255, 255, 255, 0.12);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      flex-shrink: 0;
      color: var(--accent);
    }

    .safari-arrow {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      color: var(--text-dim);
      font-size: 12px;
      animation: bounceDown 1.6s ease-in-out infinite;
    }

    @keyframes bounceDown {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(7px); }
    }
  </style>
</head>
<body data-theme="green">
  <div class="bg-layer"></div>

  <!-- 1. ЭКРАН ОБЯЗАТЕЛЬНОЙ УСТАНОВКИ НА ЭКРАН «ДОМОЙ» -->
  <div class="install-gate" id="install-gate">
    <div class="gate-top">
      <img id="gate-icon-img" class="gate-icon" alt="Dopamine Icon" />
      <div class="gate-badge">Только через экран «Домой»</div>
      <h1 class="gate-title">Установите Dopamine</h1>
      <p class="gate-desc">
        Запуск из браузера недоступен. Добавьте приложение на рабочий стол iPhone, чтобы разблокировать процедуру.
      </p>
    </div>

    <div class="gate-steps">
      <div class="step-item">
        <div class="step-num">1</div>
        <div>
          Нажмите кнопку <b>«Поделиться»</b>
          <svg style="width:16px;height:16px;vertical-align:-3px;margin:0 2px;stroke:#60a5fa" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3v12"/><path d="m8 7 4-4 4 4"/><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7"/>
          </svg>
          на нижней панели Safari.
        </div>
      </div>
      <div class="step-item">
        <div class="step-num">2</div>
