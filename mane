  <script>
    // === 1. ГЕНЕРАЦИЯ ИКОНКИ DOPAMINE (512x512 PNG ДЛЯ ЭКРАНА «ДОМОЙ») ===
    function generateDopamineIcon() {
      const canvas = document.createElement('canvas');
      canvas.width = 512;
      canvas.height = 512;
      const ctx = canvas.getContext('2d');

      // Глубокий изумрудно-чёрный градиент фона (классический стиль Dopamine)
      const bg = ctx.createRadialGradient(256, 200, 30, 256, 256, 360);
      bg.addColorStop(0, '#105c34');
      bg.addColorStop(0.55, '#072a18');
      bg.addColorStop(1, '#03120a');
      ctx.fillStyle = bg;
      ctx.fillRect(0, 0, 512, 512);

      // Мягкое неоновое свечение в центре
      const glow = ctx.createRadialGradient(256, 256, 10, 256, 256, 200);
      glow.addColorStop(0, 'rgba(52, 211, 153, 0.35)');
      glow.addColorStop(1, 'rgba(52, 211, 153, 0)');
      ctx.fillStyle = glow;
      ctx.fillRect(0, 0, 512, 512);

      // Молекулярная эмблема Dopamine
      ctx.save();
      ctx.strokeStyle = '#34d399';
      ctx.lineWidth = 20;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.shadowColor = '#10b981';
      ctx.shadowBlur = 28;

      // Шестиугольник бензольного кольца
      const cx = 205, cy = 268, r = 84;
      const pts = [];
      for (let i = 0; i < 6; i++) {
        const a = (Math.PI / 3) * i - Math.PI / 2;
        pts.push([cx + r * Math.cos(a), cy + r * Math.sin(a)]);
      }

      ctx.beginPath();
      ctx.moveTo(pts[0][0], pts[0][1]);
      for (let i = 1; i < 6; i++) ctx.lineTo(pts[i][0], pts[i][1]);
      ctx.closePath();
      ctx.stroke();

      // Цепочка этиламина справа
      ctx.beginPath();
      ctx.moveTo(pts[1][0], pts[1][1]);
      ctx.lineTo(345, 190);
      ctx.lineTo(395, 276);
      ctx.stroke();

      // Две OH-ветки слева
      ctx.beginPath();
      ctx.moveTo(pts[4][0], pts[4][1]);
      ctx.lineTo(86, 338);
      ctx.moveTo(pts[5][0], pts[5][1]);
      ctx.lineTo(86, 198);
      ctx.stroke();

      // Светящиеся узлы
      ctx.fillStyle = '#ffffff';
      [[395, 276], [86, 338], [86, 198], pts[0]].forEach(([x, y]) => {
        ctx.beginPath();
        ctx.arc(x, y, 16, 0, Math.PI * 2);
        ctx.fill();
      });
      ctx.restore();

      const dataUrl = canvas.toDataURL('image/png');
      document.getElementById('apple-touch-icon').href = dataUrl;
      document.getElementById('favicon').href = dataUrl;
      document.getElementById('gate-icon-img').src = dataUrl;
    }

    generateDopamineIcon();

    // === 2. ПРОВЕРКА РЕЖИМА «НА ЭКРАНЕ ДОМОЙ» (PWA STANDALONE) ===
    const installGate = document.getElementById('install-gate');
    function isStandaloneMode() {
      return window.navigator.standalone === true ||
        window.matchMedia('(display-mode: standalone)').matches ||
        localStorage.getItem('dopamine_dev_bypass') === '1';
    }

    if (!isStandaloneMode()) {
      installGate.classList.add('active');
    }

    // Секретный обход для тестирования в браузере (5 быстрых тапов по иконке)
    let tapCount = 0;
    let tapTimer = null;
    document.getElementById('gate-icon-img').addEventListener('click', () => {
      tapCount++;
      clearTimeout(tapTimer);
      tapTimer = setTimeout(() => { tapCount = 0; }, 1200);
      if (tapCount >= 5) {
        installGate.classList.remove('active');
      }
    });

    // === 3. СОСТОЯНИЕ И ТЕМА ФОНА ===
    const themeMetaColors = {
      green: '#061d12',
      blue: '#071b36',
      red: '#380909'
    };

    function applyTheme(theme) {
      if (!themeMetaColors[theme]) theme = 'green';
      document.body.setAttribute('data-theme', theme);
      document.getElementById('meta-theme-color').setAttribute('content', themeMetaColors[theme]);
      localStorage.setItem('dopamine_theme', theme);
      document.querySelectorAll('.theme-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.setTheme === theme);
      });
    }

    applyTheme(localStorage.getItem('dopamine_theme') || 'green');

    document.querySelectorAll('.theme-btn').forEach(btn => {
      btn.addEventListener('click', () => applyTheme(btn.dataset.setTheme));
    });

    // Автоопределение версии iOS для красоты шапки
    const iosMatch = navigator.userAgent.match(/OS (\d+_\d+(?:_\d+)?)/);
    if (iosMatch) {
      const ver = iosMatch[1].replace(/_/g, '.');
      document.getElementById('ios-subtitle').textContent = `iOS ${ver} • arm64e`;
    }

    // Тумблеры в Settings
    let verboseEnabled = true;
    document.getElementById('toggle-verbose').addEventListener('click', function () {
      this.classList.toggle('on');
      verboseEnabled = this.classList.contains('on');
    });
    document.getElementById('toggle-tweaks').addEventListener('click', function () {
      this.classList.toggle('on');
    });

    // === 4. МОДАЛКИ (SETTINGS & CREDITS) ===
    function openModal(id) { document.getElementById(id).classList.add('open'); }
    function closeModal(id) { document.getElementById(id).classList.remove('open'); }

    document.getElementById('btn-settings').addEventListener('click', () => openModal('modal-settings'));
    document.getElementById('btn-credits').addEventListener('click', () => openModal('modal-credits'));

    document.querySelectorAll('.modal-close').forEach(btn => {
      btn.addEventListener('click', () => closeModal(btn.dataset.close));
    });
    document.querySelectorAll('.modal-backdrop').forEach(bg => {
      bg.addEventListener('click', (e) => {
        if (e.target === bg) bg.classList.remove('open');
      });
    });

    // === 5. СОСТОЯНИЕ JAILBROKEN ===
    const btnJailbreak = document.getElementById('btn-jailbreak');
    const jbBtnText = document.getElementById('jb-btn-text');
    const btnRespring = document.getElementById('btn-respring');
    const btnUserspace = document.getElementById('btn-userspace');

    function setJailbrokenUI(isJB) {
      localStorage.setItem('dopamine_jb_state', isJB ? '1' : '0');
      btnRespring.classList.toggle('disabled', !isJB);
      btnUserspace.classList.toggle('disabled', !isJB);
      btnJailbreak.disabled = isJB;
      jbBtnText.textContent = isJB ? 'Jailbroken' : 'Jailbreak';
    }

    setJailbrokenUI(localStorage.getItem('dopamine_jb_state') === '1');

    document.getElementById('btn-reset-jb').addEventListener('click', () => {
      setJailbrokenUI(false);
      closeModal('modal-settings');
    });

    // === 6. СЦЕНАРИЙ ПРОЦЕССА JAILBREAK (КАК НА ВИДЕО) ===
    const menuCard = document.getElementById('menu-card');
    const jbPanel = document.getElementById('jb-panel');
    const pmView = document.getElementById('pm-view');
    const logFeed = document.getElementById('log-feed');
    const btnContinue = document.getElementById('btn-continue');

    const sleep = (ms) => new Promise(res => setTimeout(res, ms));

    function addLogLine(text, { spinner = false, sub = false } = {}) {
      const row = document.createElement('div');
      row.className = 'log-row' + (sub ? ' sub' : '');
      if (spinner) {
        row.innerHTML = `<span class="spinner"></span><span>${text}</span>`;
      } else if (sub) {
        row.innerHTML = `<span>→ ${text}</span>`;
      } else {
        row.innerHTML = `<span>✓</span><span>${text}</span>`;
      }
      logFeed.appendChild(row);
      return row;
    }

    function markRowDone(row) {
      if (!row) return;
      row.classList.add('done');
      const sp = row.querySelector('.spinner');
      if (sp) sp.outerHTML = '<span>✓</span>';
    }

    // Выбор пакетных менеджеров
    document.querySelectorAll('.pm-item').forEach(item => {
      item.addEventListener('click', () => {
        item.classList.toggle('selected');
        const check = item.querySelector('.pm-check');
        check.textContent = item.classList.contains('selected') ? '✓' : '';
        const selectedCount = document.querySelectorAll('.pm-item.selected').length;
        btnContinue.disabled = selectedCount === 0;
      });
    });

    btnJailbreak.addEventListener('click', async () => {
      menuCard.style.display = 'none';
      btnJailbreak.style.display = 'none';
      jbPanel.classList.add('active');
      pmView.classList.remove('active');
      logFeed.style.display = 'flex';
      logFeed.innerHTML = '';

      // Этап 1: Analyzing system...
      const r1 = addLogLine('Analyzing system...', { spinner: true });
      await sleep(1300);
      markRowDone(r1);
      await sleep(300);

      // Этап 2: Выбор Package Manager(s)
      logFeed.style.display = 'none';
      pmView.classList.add('active');
    });

    btnContinue.addEventListener('click', async () => {
      const selectedFiles = Array.from(document.querySelectorAll('.pm-item.selected'))
        .map(el => el.dataset.file);

      pmView.classList.remove('active');
      logFeed.style.display = 'flex';
      logFeed.innerHTML = '';

      const step1 = addLogLine('Obtaining launch daemons...', { spinner: true });
      await sleep(850);
      markRowDone(step1);

      const step2 = addLogLine('Injecting payloads...', { spinner: true });
      await sleep(900);
      markRowDone(step2);

      const step3 = addLogLine('Saving packages to Files...', { spinner: true });
      await sleep(600);
      markRowDone(step3);

      for (const file of selectedFiles) {
        addLogLine(file, { sub: true });
        await sleep(360);
      }

      addLogLine(`${selectedFiles.length} package(s) saved to Files`);
      await sleep(550);

      const step4 = addLogLine('Scheduling respring...', { spinner: true });
      await sleep(750);
      markRowDone(step4);

      const step5 = addLogLine('Finalizing...', { spinner: true });
      await sleep(1000);
      markRowDone(step5);

      // Переход к Verbose Boot или Respring
      if (verboseEnabled) {
        await runVerboseBoot();
      } else {
        await runQuickRespring();
      }

      // Возврат на главный экран в статусе Jailbroken
      jbPanel.classList.remove('active');
      menuCard.style.display = 'block';
      btnJailbreak.style.display = 'flex';
      setJailbrokenUI(true);
    });

    // === 7. VERBOSE BOOT (00:12 - 00:16) ===
    const verboseMessages = [
      'Booting Dopamine kernel',
      'cpu0: online',
      'mounting rootfs (rw)',
      'loading tweaks: 12 loaded',
      'trustcache: injected',
      'sandbox: disabled',
      'launchd: starting services',
      'respring: scheduled',
      'checking filesystem integrity',
      'mapping shared cache',
      'injecting payload hooks',
      'verifying code signatures',
      'starting SpringBoard',
      'restoring user defaults'
    ];

    async function runVerboseBoot() {
      const screen = document.getElementById('verbose-screen');
      const term = document.getElementById('verbose-terminal');
      term.innerHTML = '';
      screen.classList.add('visible');
      requestAnimationFrame(() => screen.classList.add('show'));

      let t = 0.0;
      const totalLines = 22;
      for (let i = 0; i < totalLines; i++) {
        const msg = verboseMessages[i % verboseMessages.length];
        const line = document.createElement('div');
        line.className = 'verbose-line';
        line.textContent = `[ ${t.toFixed(6)}] ${msg}`;
        term.appendChild(line);
        if (term.children.length > 14) term.removeChild(term.firstChild);
        t += 0.24 + Math.random() * 0.08;
        await sleep(190);
      }

      await sleep(600);
      screen.classList.remove('show');
      await sleep(450);
      screen.classList.remove('visible');
    }

    async function runQuickRespring() {
      const respring = document.getElementById('respring-screen');
      respring.classList.add('active');
      await sleep(2200);
      respring.classList.remove('active');
    }

    // Действия после джейлбрейка
    btnRespring.addEventListener('click', () => runQuickRespring());
    btnUserspace.addEventListener('click', () => runVerboseBoot());
  </script>
</body>
</html>
